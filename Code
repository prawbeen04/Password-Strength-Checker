<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Interactive Password Strength Checker</title>
    <style>
        * {
            box-sizing: border-box;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            transition: all 0.3s ease; 
        }

        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%); 
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            padding: 20px;
        }

        .card {
            background-color: #1e293b; 
            padding: 35px 30px;
            border-radius: 16px; 
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
            width: 100%;
            max-width: 420px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        h2 {
            margin: 0 0 8px 0;
            color: #f8fafc;
            font-size: 24px;
            text-align: center;
        }

        .subtitle {
            color: #94a3b8;
            font-size: 14px;
            text-align: center;
            margin-bottom: 25px;
        }

        .input-container {
            position: relative;
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            color: #cbd5e1;
            font-weight: 500;
            font-size: 14px;
        }

        input[type="password"], input[type="text"] {
            width: 100%;
            padding: 14px 45px 14px 14px; 
            background-color: #0f172a;
            border: 2px solid #334155;
            border-radius: 8px;
            font-size: 16px;
            color: #ffffff;
            outline: none;
        }

        input:focus {
            border-color: #6366f1;
            box-shadow: 0 0 12px rgba(99, 102, 241, 0.3);
            background-color: #111c35;
        }

        .toggle-btn {
            position: absolute;
            right: 15px;
            top: 40px; 
            background: none;
            border: none;
            color: #64748b;
            cursor: pointer;
            font-size: 14px;
            font-weight: bold;
            padding: 0;
            user-select: none;
        }

        .toggle-btn:hover {
            color: #f8fafc;
        }

        .meter-container {
            margin-bottom: 15px;
        }

        .meter-track {
            height: 6px;
            width: 100%;
            background-color: #334155;
            border-radius: 10px;
            overflow: hidden;
        }

        .meter-bar {
            height: 100%;
            width: 0%;
            border-radius: 10px;
            transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1); 
        }

        .status-badge {
            font-size: 13px;
            font-weight: 600;
            color: #94a3b8;
            display: inline-block;
            margin-bottom: 20px;
            padding: 4px 10px;
            border-radius: 20px;
            background-color: #0f172a;
        }

        .checklist-title {
            color: #cbd5e1;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .checklist {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .checklist li {
            font-size: 13px;
            color: #64748b;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
        }

        .checklist li::before {
            content: "○";
            margin-right: 10px;
            font-weight: bold;
            color: #475569;
        }

        .valid::before {
            content: "✓" !important;
            color: #10b981 !important;
        }
        .invalid::before {
            content: "✕" !important;
            color: #f43f5e !important;
        }

        .weak-ui { background-color: #f43f5e; color: #f43f5e; }
        .medium-ui { background-color: #f59e0b; color: #f59e0b; }
        .strong-ui { background-color: #10b981; color: #10b981; }

    </style>
</head>
<body>

<div class="card">
    <h2>Secure Check</h2>
    <div class="subtitle">Evaluate your password strength instantly</div>

    <div class="input-container">
        <label for="password">Password</label>
        <input type="password" id="password" placeholder="Create a strong password">
        <button type="button" id="toggle-visibility" class="toggle-btn">Show</button>
    </div>

    <div class="meter-container">
        <div class="meter-track">
            <div id="meter-bar" class="meter-bar"></div>
        </div>
    </div>
    
    <div id="status-badge" class="status-badge">Waiting for input...</div>

    <div class="checklist-title">Security Requirements:</div>
    <ul class="checklist">
        <li id="rule-len">At least 8 characters long</li>
        <li id="rule-upper">Contains an uppercase letter</li>
        <li id="rule-num">Contains a numeric digit</li>
        <li id="rule-spec">Contains a special character</li>
    </ul>
</div>

<script>
    const passwordInput = document.getElementById('password');
    const toggleBtn = document.getElementById('toggle-visibility');
    const meterBar = document.getElementById('meter-bar');
    const statusBadge = document.getElementById('status-badge');

    const ruleLen = document.getElementById('rule-len');
    const ruleUpper = document.getElementById('rule-upper');
    const ruleNum = document.getElementById('rule-num');
    const ruleSpec = document.getElementById('rule-spec');

    toggleBtn.addEventListener('click', () => {
        if (passwordInput.type === 'password') {
            passwordInput.type = 'text';
            toggleBtn.textContent = 'Hide';
        } else {
            passwordInput.type = 'password';
            toggleBtn.textContent = 'Show';
        }
    });

    passwordInput.addEventListener('input', () => {
        const val = passwordInput.value;
        let score = 0;

        if (val.length === 0) {
            meterBar.style.width = '0%';
            statusBadge.textContent = 'Waiting for input...';
            statusBadge.style.color = '#94a3b8';
            clearChecklist();
            return;
        }

        if (val.length >= 8) { score++; updateRuleUI(ruleLen, true); } 
        else { updateRuleUI(ruleLen, false); }

        if (/[A-Z]/.test(val)) { score++; updateRuleUI(ruleUpper, true); } 
        else { updateRuleUI(ruleUpper, false); }

        if (/[0-9]/.test(val)) { score++; updateRuleUI(ruleNum, true); } 
        else { updateRuleUI(ruleNum, false); }

        if (/[^A-Za-z0-9]/.test(val)) { score++; updateRuleUI(ruleSpec, true); } 
        else { updateRuleUI(ruleSpec, false); }

        if (score <= 2) {
            meterBar.style.width = '33%';
            meterBar.className = 'meter-bar weak-ui';
            statusBadge.textContent = 'Weak';
            statusBadge.style.color = '#f43f5e';
        } else if (score === 3) {
            meterBar.style.width = '66%';
            meterBar.className = 'meter-bar medium-ui';
            statusBadge.textContent = 'Medium';
            statusBadge.style.color = '#f59e0b';
        } else if (score === 4) {
            meterBar.style.width = '100%';
            meterBar.className = 'meter-bar strong-ui';
            statusBadge.textContent = 'Strong & Secure';
            statusBadge.style.color = '#10b981';
        }
    });

    function updateRuleUI(element, isValid) {
        if (isValid) {
            element.className = 'valid';
            element.style.color = '#e2e8f0';
        } else {
            element.className = 'invalid';
            element.style.color = '#64748b';
        }
    }

    function clearChecklist() {
        const rules = [ruleLen, ruleUpper, ruleNum, ruleSpec];
        rules.forEach(rule => {
            rule.className = '';
            rule.style.color = '#64748b';
        });
    }
</script>

</body>
</html>
